// https://grafana.com/docs/alloy/latest/reference/components/prometheus/prometheus.scrape
//

prometheus.scrape "self" {
  targets = [
    {"__address__" = "localhost:12345", "job"="alloy"},
  ]

  metrics_path    = "/metrics"
  scrape_interval = "10s"
  forward_to      = [prometheus.relabel.default.receiver]
}

prometheus.scrape "services" {
  targets = [
    {"__address__" = "node-exporter:9100", "job"="node-exporter"},
    {"__address__" = "cadvisor:8080", "job"="cadvisor"},
    {"__address__" = "host.internal:8080", "job"="host:8080"},
    {"__address__" = "host.internal:8081", "job"="host:8081"},
    {"__address__" = "host.internal:8443", "job"="host:8443"},
    {"__address__" = "host.internal:8444", "job"="host:8444"},
  ]

  metrics_path    = "/metrics"
  scrape_interval = "10s"
  forward_to      = [prometheus.relabel.default.receiver]
}
